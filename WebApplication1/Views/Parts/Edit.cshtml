@model WebApplication1.Models.Part

@{
    ViewData["Title"] = "Edytuj część";
}

<h1>Edytuj część</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CatalogNumber" class="form-label"></label>
        <input asp-for="CatalogNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PurchaseNetPrice" class="form-label"></label>
        <input asp-for="PurchaseNetPrice" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="MarginPercent" class="form-label"></label>
        <input asp-for="MarginPercent" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="QuantityInStock" class="form-label"></label>
        <input asp-for="QuantityInStock" class="form-control" type="number" />
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Zapisz zmiany</button>

    <a asp-controller="Parts" asp-action="Index" class="btn btn-secondary">
        Wróć
    </a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}