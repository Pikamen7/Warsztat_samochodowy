@model WebApplication1.Models.ServiceOrder

@{
    ViewData["Title"] = "Edytuj zlecenie #" + Model.Id;
    var totalNet = Model.LaborCost + Model.Items.Sum(i => i.TotalPrice);
    var totalGross = Math.Round(totalNet * 1.23m, 2);
}

<h1>Zlecenie #@Model.Id</h1>

<div class="row">
    <div class="col-md-6">
        <h5>Dane zlecenia</h5>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="CustomerId" class="form-label"></label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                    <option value="">— wybierz klienta —</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="ViewBag.Statuses" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="LaborCost" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="LaborCost" class="form-control" type="number" step="0.01" min="0" />
                    <span class="input-group-text">zł</span>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Zapisz zmiany</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Wróć</a>
        </form>
    </div>
</div>

<hr />

<h5>Części i usługi</h5>

@if (Model.Items.Any())
{
    <table class="table table-sm">
        <thead>
        <tr>
            <th>Nazwa</th>
            <th>Ilość</th>
            <th>Cena jedn. netto</th>
            <th>Wartość netto</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N2") zł</td>
                <td>@item.TotalPrice.ToString("N2") zł</td>
                <td>
                    <form asp-action="RemoveItem" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="itemId" value="@item.Id" />
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">Usuń</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Brak pozycji. Dodaj poniżej.</p>
}

<div class="card mt-2 mb-4" style="max-width: 500px;">
    <div class="card-body">
        <h6 class="card-title">Dodaj pozycję</h6>
        <form asp-action="AddItem" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.Id" />

            <div class="mb-2">
                <label class="form-label">Nazwa części / usługi</label>
                <input name="Name" class="form-control" required />
            </div>
            <div class="row g-2 mb-2">
                <div class="col">
                    <label class="form-label">Ilość</label>
                    <input name="Quantity" type="number" min="1" value="1" class="form-control" required />
                </div>
                <div class="col">
                    <label class="form-label">Cena jedn. netto (zł)</label>
                    <input name="UnitPrice" type="number" step="0.01" min="0" value="0" class="form-control" required />
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Dodaj</button>
        </form>
    </div>
</div>

<div class="table-responsive" style="max-width: 400px;">
    <table class="table table-bordered">
        <tr>
            <th>Robocizna netto</th>
            <td class="text-end">@Model.LaborCost.ToString("N2") zł</td>
        </tr>
        <tr>
            <th>Części netto</th>
            <td class="text-end">@Model.Items.Sum(i => i.TotalPrice).ToString("N2") zł</td>
        </tr>
        <tr class="table-active fw-bold">
            <th>Łącznie netto</th>
            <td class="text-end">@totalNet.ToString("N2") zł</td>
        </tr>
        <tr>
            <th>VAT 23%</th>
            <td class="text-end">@(Math.Round(totalNet * 0.23m, 2).ToString("N2")) zł</td>
        </tr>
        <tr class="table-success fw-bold">
            <th>Łącznie brutto</th>
            <td class="text-end">@totalGross.ToString("N2") zł</td>
        </tr>
    </table>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
