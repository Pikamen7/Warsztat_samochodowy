@model WebApplication1.Models.ServiceOrder

@{
    ViewData["Title"] = "Zlecenie #" + Model.Id;
    var totalNet = Model.LaborCost + Model.Items.Sum(i => i.TotalPrice);
    var totalGross = Math.Round(totalNet * 1.23m, 2);
    var statusLabel = Model.Status switch
    {
        WebApplication1.Models.ServiceOrderStatus.Nowe       => "Nowe",
        WebApplication1.Models.ServiceOrderStatus.WTrakcie   => "W trakcie",
        WebApplication1.Models.ServiceOrderStatus.Zakonczone => "Zakończone",
        WebApplication1.Models.ServiceOrderStatus.Anulowane  => "Anulowane",
        _ => ""
    };
    var statusClass = Model.Status switch
    {
        WebApplication1.Models.ServiceOrderStatus.Nowe       => "bg-primary",
        WebApplication1.Models.ServiceOrderStatus.WTrakcie   => "bg-warning text-dark",
        WebApplication1.Models.ServiceOrderStatus.Zakonczone => "bg-success",
        WebApplication1.Models.ServiceOrderStatus.Anulowane  => "bg-secondary",
        _ => ""
    };
}

<h1>Zlecenie #@Model.Id <span class="badge @statusClass">@statusLabel</span></h1>

<div class="row mb-4">
    <div class="col-md-6">
        <table class="table">
            <tr>
                <th>Klient</th>
                <td>@Model.Customer?.LastName @Model.Customer?.FirstName</td>
            </tr>
            <tr>
                <th>Telefon</th>
                <td>@Model.Customer?.PhoneNumber</td>
            </tr>
            <tr>
                <th>Auto</th>
                <td>@Model.Customer?.CarBrand @Model.Customer?.CarModel</td>
            </tr>
            <tr>
                <th>Rejestracja</th>
                <td>@Model.Customer?.RegistrationNumber</td>
            </tr>
            <tr>
                <th>Data przyjęcia</th>
                <td>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
            </tr>
            <tr>
                <th>Opis prac</th>
                <td>@Model.Description</td>
            </tr>
        </table>
    </div>
</div>

<h5>Części i usługi</h5>

@if (Model.Items.Any())
{
    <table class="table table-sm table-striped" style="max-width: 700px;">
        <thead>
        <tr>
            <th>Nazwa</th>
            <th class="text-end">Ilość</th>
            <th class="text-end">Cena jedn. netto</th>
            <th class="text-end">Wartość netto</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td class="text-end">@item.Quantity</td>
                <td class="text-end">@item.UnitPrice.ToString("N2") zł</td>
                <td class="text-end">@item.TotalPrice.ToString("N2") zł</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Brak pozycji.</p>
}

<div class="table-responsive mt-3" style="max-width: 400px;">
    <table class="table table-bordered">
        <tr>
            <th>Robocizna netto</th>
            <td class="text-end">@Model.LaborCost.ToString("N2") zł</td>
        </tr>
        <tr>
            <th>Części netto</th>
            <td class="text-end">@Model.Items.Sum(i => i.TotalPrice).ToString("N2") zł</td>
        </tr>
        <tr class="table-active fw-bold">
            <th>Łącznie netto</th>
            <td class="text-end">@totalNet.ToString("N2") zł</td>
        </tr>
        <tr>
            <th>VAT 23%</th>
            <td class="text-end">@(Math.Round(totalNet * 0.23m, 2).ToString("N2")) zł</td>
        </tr>
        <tr class="table-success fw-bold">
            <th>Łącznie brutto</th>
            <td class="text-end">@totalGross.ToString("N2") zł</td>
        </tr>
    </table>
</div>

<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Edytuj</a>
<a class="btn btn-secondary" asp-action="Index">Wróć do listy</a>
